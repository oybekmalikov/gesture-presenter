let currentLang = localStorage.getItem('safeguard_lang') || 'ru';

function toggleLangMenu() {
  document.getElementById('langSwitcher').classList.toggle('open');
}

// Close menu when clicking outside
document.addEventListener('click', (e) => {
  const switcher = document.getElementById('langSwitcher');
  if (switcher && !switcher.contains(e.target)) {
    switcher.classList.remove('open');
  }
});

function setLanguage(langCode, event) {
  if (event) event.stopPropagation();

  if (!DICTIONARY[langCode]) return;

  currentLang = langCode;
  localStorage.setItem('safeguard_lang', langCode);

  // Update Switcher UI
  const switcher = document.getElementById('langSwitcher');
  switcher.querySelector('.lang-current .lang-flag').textContent = DICTIONARY[langCode].flag;
  switcher.querySelector('.lang-current .lang-text').textContent = DICTIONARY[langCode].name;
  switcher.classList.remove('open');

  applyTranslations();
}

function applyTranslations() {
  const dict = DICTIONARY[currentLang].strings;
  const englishDict = DICTIONARY['en'].strings;

  // 1. Translate Text Nodes (Very fast DOM traversal)
  const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null, false);
  let node;
  while ((node = walker.nextNode())) {
    let text = node.nodeValue.trim();
    if (!text) continue;

    // To translate from any language back to target language, we check if the text matches 
    // ANY known translation, map it back to English key, then to target language.
    let engKey = null;

    // Check if it's already English
    if (englishDict[text]) {
      engKey = text;
    } else {
      // Find what English key this translated string belongs to
      for (const [key, val] of Object.entries(DICTIONARY.ru.strings)) { if (val === text) engKey = key; }
      if (!engKey) {
        for (const [key, val] of Object.entries(DICTIONARY.uz.strings)) { if (val === text) engKey = key; }
      }
    }

    if (engKey && dict[engKey]) {
      node.nodeValue = node.nodeValue.replace(text, dict[engKey]);
    }
  }

  // 2. Translate Placeholders (Inputs)
  document.querySelectorAll('input[placeholder]').forEach(input => {
    let text = input.getAttribute('placeholder');
    let engKey = null;
    if (englishDict[text]) engKey = text;
    else {
      for (const [key, val] of Object.entries(DICTIONARY.ru.strings)) { if (val === text) engKey = key; }
      if (!engKey) {
        for (const [key, val] of Object.entries(DICTIONARY.uz.strings)) { if (val === text) engKey = key; }
      }
    }
    if (engKey && dict[engKey]) {
      input.setAttribute('placeholder', dict[engKey]);
    }
  });
}

// Initialize on load
window.addEventListener('DOMContentLoaded', () => {
  setLanguage(currentLang);
});
